{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https://via.placeholder.com https://iewrvbzgygmpcrlaqsaq.supabase.co; connect-src 'self' https://script.google.com https://iewrvbzgygmpcrlaqsaq.supabase.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://script.google.com; object-src 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/admin/:path*",
      "destination": "/api/admin?cms_route=:path*"
    },
    {
      "source": "/api/newsletter",
      "destination": "/api/admin?public_route=newsletter"
    },
    {
      "source": "/api/member-photo",
      "destination": "/api/admin?public_route=member-photo"
    }
  ],
  "functions": {
    "api/admin.mjs": {
      "includeFiles": [
        "admin/server/**",
        "admin/seed.json",
        "*.html",
        "projects/**",
        "Javascript/**"
      ],
      "maxDuration": 30
    }
  },
  "outputDirectory": "dist",
  "buildCommand": "npm run build"
}
