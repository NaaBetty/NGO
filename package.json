{
  "name": "le-shelter-foundation",
  "version": "1.0.0",
  "scripts": {
    "admin": "node --env-file-if-exists=.env admin/server/server.mjs",
    "build:css": "tailwindcss -i css/tailwind-input.css -o css/tailwind.css --minify",
    "watch:css": "tailwindcss -i css/tailwind-input.css -o css/tailwind.css --watch",
    "migrate:cms": "node --env-file-if-exists=.env tools/migrate-cms.mjs",
    "test:membership": "node --test tools/membership-client.test.mjs admin/server/membership-csp.test.mjs",
    "build:qr": "esbuild ./node_modules/qrcode/lib/browser.js --bundle --format=esm --minify --outfile=Javascript/vendor/qrcode.js",
    "build": "node tools/build-site.mjs",
    "check:cloud": "node --env-file-if-exists=.env tools/check-cloud.mjs",
    "test:cloud": "node --test tools/cloud-migration.test.mjs tools/cloud-server.test.mjs tools/membership-client.test.mjs admin/server/membership-csp.test.mjs admin/server/newsletter.test.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "tailwindcss": "^3.4.0"
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "engines": {
    "node": "24.x"
  }
}
